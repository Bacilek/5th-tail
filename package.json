{
  "name": "5th-tail",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "app": "npm run build && electron .",
    "package": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "playwright-core": "^1.65.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  },
  "main": "electron/main.cjs",
  "productName": "Fifth Tail",
  "description": "Fifth Tail - a Fourth Wing x Skyrim fan game",
  "build": {
    "appId": "dev.marek.fifthtail",
    "productName": "Fifth Tail",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Fifth Tail"
    },
    "portable": {
      "artifactName": "FifthTail-portable.exe"
    }
  }
}
